# OpenAI API Key
OPENAI_API_KEY=sk-your-key-here

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-your-key-here

# Gemini API Key
GEMINI_API_KEY=AIza-your-key-here

# 阿里百炼 API Key (推荐)
BAILIAN_API_KEY=sk-your-bailian-key-here

# Local diarization model directory (optional, preferred)
# Example: C:/models/pyannote/speaker-diarization-3.1
DIARIZATION_MODEL_PATH=

# Diarization model id (used when local path is empty)
DIARIZATION_MODEL_ID=pyannote/speaker-diarization-3.1

# HuggingFace Token (optional; only needed when using remote model id)
HF_TOKEN=hf_your-huggingface-token-here

# Python Server Port
PYTHON_SERVER_PORT=8000
